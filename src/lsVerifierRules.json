{
  "version": 5,
  "rules": [
    {
      "id": "mn-colon",
      "enabled": true,
      "section": "MN",
      "check": "startsWith",
      "severity": "error",
      "value": ":",
      "message": "MN line must contain a colon (text before the colon is ignored)."
    },
    {
      "id": "mn-semicolon",
      "enabled": true,
      "section": "MN",
      "check": "endsWith",
      "severity": "error",
      "value": ";",
      "message": "MN line must end with a semicolon."
    },
    {
      "id": "sections",
      "enabled": true,
      "check": "sections",
      "severity": "error",
      "message": "LS sections:"
    },
    {
      "id": "programName",
      "enabled": true,
      "check": "programName",
      "severity": "error",
      "message": "LS programName:"
    },
    {
      "id": "delimiters",
      "enabled": true,
      "check": "delimiters",
      "severity": "critical",
      "message": "LS delimiters:"
    },
    {
      "id": "extraColon",
      "enabled": true,
      "check": "extraColon",
      "severity": "critical",
      "message": "LS extra colon:"
    },
    {
      "id": "labels",
      "enabled": true,
      "check": "labels",
      "severity": "error",
      "message": "LS labels:"
    },
    {
      "id": "jumpTargets",
      "enabled": true,
      "check": "jumpTargets",
      "severity": "error",
      "message": "LS jump targets:"
    },
    {
      "id": "positions",
      "enabled": true,
      "check": "positions",
      "severity": "error",
      "message": "LS positions:"
    },
    {
      "id": "motion",
      "enabled": true,
      "check": "motion",
      "severity": "warning",
      "message": "LS motion:"
    },
    {
      "id": "calls",
      "enabled": true,
      "check": "calls",
      "severity": "warning",
      "message": "LS calls:"
    },
    {
      "id": "descriptions",
      "enabled": true,
      "check": "descriptions",
      "severity": "warning",
      "message": "LS descriptions:"
    }
  ]
}
