{
  "name": "robot-ftp",
  "displayName": "Robot FTP",
  "description": "VSCODE extension to FTP *.ls file to Fanuc Robot",
  "publisher": "CoreyApplegate",
  "version": "0.4.3",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
		"Formatters",
    "Snippets"
  ],
	"keywords": [
		"Fanuc",
		"TP",
		"LS"
	],
  "activationEvents": [
    "workspaceContains:**/*.ls"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
			{
				"id": "fanuctp",
				"extensions": [
					".ls"
				],
				"aliases": [
					"Fanuc TP Program"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "fanuctp",
				"scopeName": "source.fanuctp",
				"path": "./syntaxes/fanuctp.tmLanguage.json"
			}
		],
    "snippets": [
      {
        "language": "fanuctp",
        "path": "./snippets/snippets.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "extension.listLsFilesAndInsert",
        "title": "List ls Programs"
      },
      {
        "command": "extension.updateFilesFromRobotLsFiles",
        "title": "Get Update LS Folder from Robot"
      },
      {
        "command": "extension.updateSelectedFileFromRobot",
        "title": "Get Update For This LS File from Robot"
      },
      {
        "command": "extension.downloadAllFiles",
        "title": "Get ALL Files from Robot"
      },
      {
        "command": "extension.downloadLsFiles",
        "title": "Get All LS Files from Robot"
      },
  
      {
        "command": "extension.uploadFileToRobot",
        "title": "Send This LS File to Robot",
        "icon": {
          "light": "./src/images/icon-light.png",
          "dark": "./src/images/icon-dark.png"
        }
      },
      {
        "command": "extension.uploadFolderToRobot",
        "title": "Send Folder to Robot",
        "icon": {
          "light": "./src/images/icon-light.png",
          "dark": "./src/images/icon-dark.png"
        }
      },
      {
        "command": "extension.selectCSVFile",
        "title": "Select CSV File For Hints",
        "icon": {
          "light": "./src/images/icon-light.png",
          "dark": "./src/images/icon-dark.png"
        }
      }
    ],
    "keybindings": [
      {
        "command": "extension.listLsFilesAndInsert",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ],
    "submenus": [
      {
        "id": "MNAutomation.submenu",
        "label": "MNAutomation"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.listLsFilesAndInsert",
          "group": "fanucHelpers"
        }
      ],
      "explorer/context": [
        {
          "submenu": "MNAutomation.submenu",
          "group": "MNAutomation"
        }
      ],
      "MNAutomation.submenu": [
      
        {
          "command": "extension.uploadFileToRobot",
          "group": "fanucSend"
        },
        {
          "command": "extension.uploadFolderToRobot",
          "when": "explorerResourceIsFolder",
          "group": "fanucSend"
        },
        {
          "command": "extension.selectCSVFile",
          "group": "fanucNavigation"
        },
        {
          "command": "extension.downloadAllFiles",
          "group": "fanucGet"
        },
        {
          "command": "extension.downloadLsFiles",
          "group": "fanucGet"
        },
        {
          "command": "extension.updateFilesFromRobotLsFiles",
          "group": "fanucGet"
        },
        {
          "command": "extension.updateSelectedFileFromRobot",
          "group": "fanucGet"
        }
      ]
    },
    "configuration": {
      "title": "Robot FTP",
      "properties": {
        "robotFtp.port": {
          "type": "number",
          "default": 21,
          "description": "FTP port for the robot (default: 21 for standard FTP, use 9125 for RoboGuide)"
        },
        "robotFtp.username": {
          "type": "string",
          "default": "Administrator",
          "description": "FTP username for the robot (default: Administrator)"
        },
        "robotFtp.password": {
          "type": "string",
          "default": "",
          "description": "FTP password for the robot (default: empty for RoboGuide)"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.13.0"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "csv-parser": "^3.0.0"
  },
  "icon": "src/images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cpapplefamily/Fanuc_FTP_-Extension"
  }
}
