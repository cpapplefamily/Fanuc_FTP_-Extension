{
  "name": "robot-ftp",
  "displayName": "Robot FTP",
  "description": "VSCODE extension to FTP *.ls file to Fanuc Robot",
  "publisher": "CoreyApplegate",
  "version": "0.11.1-dev",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "Fanuc",
    "TP",
    "LS"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ls",
    "workspaceContains:**/*.LS",
    "onLanguage:fanuctp",
    "onCommand:extension.openUserSnippets",
    "onCommand:extension.openProjectSnippets",
    "onCommand:extension.selectExternalSnippets",
    "onCommand:extension.clearExternalSnippets"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fanuctp",
        "extensions": [
          ".ls",
          ".LS"
        ],
        "aliases": [
          "Fanuc TP Program"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fanuctp",
        "scopeName": "source.fanuctp",
        "path": "./syntaxes/fanuctp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fanuctp",
        "path": "./snippets/snippets.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "extension.verifyLsFile",
        "title": "Verify LS File",
        "enablement": "!explorerResourceIsFolder && resourceExtname =~ /\\.ls$/i"
      },
      {
        "command": "extension.openSettings",
        "title": "Robot FTP Settings"
      },
      {
        "command": "extension.editRobotList",
        "title": "Edit Robot List"
      },
      {
        "command": "extension.resetReminders",
        "title": "Reset Robot FTP Reminders"
      },
      {
        "command": "extension.openLsVerifierRules",
        "title": "Edit LS Verifier Rules"
      },
      {
        "command": "extension.resetLsVerifierRules",
        "title": "Reset LS Verifier Rules to Defaults"
      },
      {
        "command": "extension.renameLsFile",
        "title": "Rename LS File",
        "enablement": "!explorerResourceIsFolder && resourceExtname =~ /\\.ls$/i"
      },
      {
        "command": "extension.listLsFilesAndInsert",
        "title": "List ls Programs"
      },
      {
        "command": "extension.openUserSnippets",
        "title": "Open User Fanuc Snippets"
      },
      {
        "command": "extension.openProjectSnippets",
        "title": "Create/Open Project Fanuc Snippets File"
      },
      {
        "command": "extension.selectExternalSnippets",
        "title": "Load External Fanuc Snippets"
      },
      {
        "command": "extension.clearExternalSnippets",
        "title": "Clear External Fanuc Snippets"
      },
      {
        "command": "extension.updateFilesFromRobotLsFiles",
        "title": "Get Update LS Folder from Robot"
      },
      {
        "command": "extension.updateSelectedFileFromRobot",
        "title": "Get Update For This LS File from Robot"
      },
      {
        "command": "extension.makeRestoreFolder",
        "title": "Make Restore Folder (flat copy for the controller)",
        "enablement": "explorerResourceIsFolder"
      },
      {
        "command": "extension.downloadAllFiles",
        "title": "Get ALL Files from Robot"
      },
      {
        "command": "extension.downloadLsFiles",
        "title": "Get All LS Files from Robot"
      },
      {
        "command": "extension.uploadFileToRobot",
        "title": "Send This LS File to Robot",
        "icon": {
          "light": "./src/images/icon-light.png",
          "dark": "./src/images/icon-dark.png"
        }
      },
      {
        "command": "extension.uploadFolderToRobot",
        "title": "Send Folder to Robot",
        "icon": {
          "light": "./src/images/icon-light.png",
          "dark": "./src/images/icon-dark.png"
        },
        "enablement": "explorerResourceIsFolder"
      },
      {
        "command": "extension.editDescriptions",
        "title": "Edit Descriptions"
      },
      {
        "command": "extension.createDescriptionsFromBackup",
        "title": "Create Descriptions from Backup",
        "enablement": "explorerResourceIsFolder"
      },
      {
        "command": "extension.getDescriptionsFromRobot",
        "title": "Get Descriptions from Robot"
      },
      {
        "command": "extension.sendDescriptionsToRobot",
        "title": "Send Descriptions to Robot"
      },
      {
        "command": "extension.setDescription",
        "title": "Robot FTP: Set Description of I/O or Register at Cursor"
      },
      {
        "command": "extension.updateDescriptionsFromLsFile",
        "title": "Update Descriptions from LS Comments"
      }
    ],
    "keybindings": [
      {
        "command": "extension.listLsFilesAndInsert",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ],
    "colors": [
      {
        "id": "robotFtp.robotDescriptionForeground",
        "description": "Color of descriptions from the robot's own file (.vscode/descriptions/<robot>.csv). Default: the theme's inlay hint color (tan in the default dark theme).",
        "defaults": {
          "dark": "editorInlayHint.foreground",
          "light": "editorInlayHint.foreground",
          "highContrast": "editorInlayHint.foreground",
          "highContrastLight": "editorInlayHint.foreground"
        }
      },
      {
        "id": "robotFtp.sharedDescriptionForeground",
        "description": "Color of descriptions from the shared file (.vscode/descriptions/shared.csv). Default: pink.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#AF00DB",
          "highContrast": "#D670D6",
          "highContrastLight": "#AF00DB"
        }
      }
    ],
    "submenus": [
      {
        "id": "MNAutomation.submenu",
        "label": "MNAutomation"
      },
      {
        "id": "MNAutomation.descriptions",
        "label": "Descriptions"
      },
      {
        "id": "MNAutomation.lsChecker",
        "label": "LS Checker"
      },
      {
        "id": "MNAutomation.snippets",
        "label": "Snippets"
      },
      {
        "id": "MNAutomation.send",
        "label": "Send to Robot"
      },
      {
        "id": "MNAutomation.get",
        "label": "Get from Robot"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.listLsFilesAndInsert",
          "group": "fanucHelpers"
        },
        {
          "command": "extension.updateDescriptionsFromLsFile",
          "when": "editorLangId == fanuctp",
          "group": "fanucHelpers"
        }
      ],
      "explorer/context": [
        {
          "submenu": "MNAutomation.submenu",
          "group": "MNAutomation"
        }
      ],
      "MNAutomation.submenu": [
        {
          "submenu": "MNAutomation.lsChecker",
          "group": "fanucHelpers"
        },
        {
          "command": "extension.renameLsFile",
          "group": "fanucHelpers"
        },
        {
          "submenu": "MNAutomation.send",
          "group": "1_robot@2"
        },
        {
          "submenu": "MNAutomation.descriptions",
          "group": "fanucNavigation"
        },
        {
          "submenu": "MNAutomation.snippets",
          "group": "fanucNavigation"
        },
        {
          "submenu": "MNAutomation.get",
          "group": "1_robot@1"
        },
        {
          "command": "extension.editRobotList",
          "group": "z_fanucSettings"
        },
        {
          "command": "extension.resetReminders",
          "group": "z_fanucSettings"
        },
        {
          "command": "extension.openSettings",
          "group": "z_fanucSettings"
        }
      ],
      "MNAutomation.descriptions": [
        {
          "command": "extension.getDescriptionsFromRobot",
          "group": "1_create@1"
        },
        {
          "command": "extension.createDescriptionsFromBackup",
          "group": "1_create@2"
        },
        {
          "command": "extension.editDescriptions",
          "group": "2_edit@1"
        },
        {
          "command": "extension.updateDescriptionsFromLsFile",
          "when": "resourceExtname =~ /\\.ls$/i",
          "group": "2_edit@2"
        },
        {
          "command": "extension.sendDescriptionsToRobot",
          "group": "3_send@1"
        }
      ],
      "MNAutomation.lsChecker": [
        {
          "command": "extension.verifyLsFile",
          "group": "1_check@1"
        },
        {
          "command": "extension.openLsVerifierRules",
          "group": "2_rules@1"
        },
        {
          "command": "extension.resetLsVerifierRules",
          "group": "2_rules@2"
        }
      ],
      "MNAutomation.snippets": [
        {
          "command": "extension.openUserSnippets",
          "group": "1_open@1"
        },
        {
          "command": "extension.openProjectSnippets",
          "group": "1_open@2"
        },
        {
          "command": "extension.selectExternalSnippets",
          "group": "2_external@1"
        },
        {
          "command": "extension.clearExternalSnippets",
          "group": "2_external@2"
        }
      ],
      "MNAutomation.send": [
        {
          "command": "extension.uploadFileToRobot",
          "group": "1_send@1"
        },
        {
          "command": "extension.uploadFolderToRobot",
          "group": "1_send@2"
        }
      ],
      "MNAutomation.get": [
        {
          "command": "extension.downloadAllFiles",
          "group": "1_new@1"
        },
        {
          "command": "extension.downloadLsFiles",
          "group": "1_new@2"
        },
        {
          "command": "extension.updateFilesFromRobotLsFiles",
          "group": "2_update@1"
        },
        {
          "command": "extension.updateSelectedFileFromRobot",
          "group": "2_update@2"
        },
        {
          "command": "extension.makeRestoreFolder",
          "group": "3_backup@1"
        }
      ]
    },
    "configuration": {
      "title": "Robot FTP",
      "properties": {
        "robotFtp.port": {
          "type": "number",
          "default": 21,
          "description": "FTP port for the robot (default: 21 for standard FTP, use 9125 for RoboGuide). A robot in .vscode/robot-ftp.json with its own port uses that port instead."
        },
        "robotFtp.username": {
          "type": "string",
          "default": "Administrator",
          "description": "FTP username for the robot (default: Administrator)"
        },
        "robotFtp.password": {
          "type": "string",
          "default": "",
          "description": "FTP password for the robot (default: empty for RoboGuide)"
        },
        "robotFtp.externalSnippetsFile": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Absolute path to an external Fanuc .code-snippets or JSON file. This augments the built-in snippets."
        },
        "robotFtp.downloadLayout": {
          "type": "string",
          "enum": [
            "dated",
            "fixed"
          ],
          "enumDescriptions": [
            "Each download goes into a new dated folder, e.g. 2026-11-16-ALL_01 (default).",
            "Downloads go into ALL or LS inside the chosen folder and overwrite it, so git shows what changed on the robot. Files deleted on the robot are not deleted locally."
          ],
          "default": "dated",
          "scope": "resource",
          "description": "Where Get ALL Files and Get All LS Files save the files."
        },
        "robotFtp.downloadSort": {
          "type": "string",
          "enum": [
            "sorted",
            "flat"
          ],
          "enumDescriptions": [
            "Sort downloaded files into sub-folders by type (Programs, System, Diagnostics, …), using robotFtp.downloadFolders.",
            "Keep all downloaded files in one folder, as on the robot."
          ],
          "default": "sorted",
          "scope": "resource",
          "description": "How Get ALL Files and Get All LS Files arrange the downloaded files. Use 'Make Restore Folder' to get a flat copy of a sorted backup for restoring a controller."
        },
        "robotFtp.downloadFolders": {
          "type": "object",
          "default": {
            "programs": "Programs",
            "tp": "TP",
            "registers": "Registers",
            "io": "IO",
            "karel": "KAREL",
            "vision": "Vision",
            "web": "Web",
            "systemPrograms": "System/Programs",
            "systemVariables": "System/Variables",
            "systemConfig": "System/Config",
            "diagnostics": "Diagnostics",
            "other": "Other"
          },
          "properties": {
            "programs": {
              "type": "string"
            },
            "tp": {
              "type": "string"
            },
            "registers": {
              "type": "string"
            },
            "io": {
              "type": "string"
            },
            "karel": {
              "type": "string"
            },
            "vision": {
              "type": "string"
            },
            "web": {
              "type": "string"
            },
            "systemPrograms": {
              "type": "string"
            },
            "systemVariables": {
              "type": "string"
            },
            "systemConfig": {
              "type": "string"
            },
            "diagnostics": {
              "type": "string"
            },
            "other": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "scope": "resource",
          "markdownDescription": "Folder name template for sorted downloads. `/` makes nested folders (`System/Programs`); an empty name keeps those files at the top. `tp` is the sub-folder for `.tp` binaries inside the folder of their `.ls`. Example: `\"programs\": \"1 Programs\"` to list programs first."
        },
        "robotFtp.systemPrograms": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "-BCKED*-",
            "SV_ADJST",
            "GETDATA",
            "SENDDATA",
            "SENDEVNT",
            "SENDSYSV",
            "REQMENU",
            "CLSKP*"
          ],
          "scope": "resource",
          "markdownDescription": "FANUC-supplied TP programs (names without extension, `*` and `?` wildcards). Sorted downloads put them in the `systemPrograms` folder instead of with your programs."
        },
        "robotFtp.git.onDownload": {
          "type": "string",
          "enum": [
            "prompt",
            "off"
          ],
          "default": "prompt",
          "scope": "resource",
          "description": "After downloading or updating files from the robot, ask for a commit message and commit the downloaded files."
        },
        "robotFtp.git.onUpload": {
          "type": "string",
          "enum": [
            "prompt",
            "off"
          ],
          "default": "prompt",
          "scope": "resource",
          "description": "After uploading files to the robot, commit any uncommitted edits in the uploaded files."
        },
        "robotFtp.git.commitMode": {
          "type": "string",
          "enum": [
            "auto",
            "confirm"
          ],
          "enumDescriptions": [
            "Commit as soon as the message is entered.",
            "After the message, ask \"Commit N files to <branch>?\" with Commit / Open Source Control."
          ],
          "default": "auto",
          "scope": "resource",
          "description": "What happens after you enter the commit message."
        },
        "robotFtp.git.messageTemplate": {
          "type": "string",
          "default": "${operation} ${robot} ${date}",
          "scope": "resource",
          "markdownDescription": "Suggested commit message. Variables: `${operation}` (e.g. Download LS files, Upload), `${robot}` (name and IP), `${name}`, `${ip}`, `${date}`, `${count}` (files), `${folder}` (relative to the repository)."
        },
        "robotFtp.git.push": {
          "type": "string",
          "enum": [
            "never",
            "ask",
            "always"
          ],
          "default": "never",
          "scope": "resource",
          "description": "Push after committing. Repositories without a remote are never pushed."
        },
        "robotFtp.git.offerInit": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "When the files are not in a git repository, offer to create one."
        },
        "robotFtp.git.ignorePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "*.Sem",
            "*.Wrk",
            "*-Restore*/"
          ],
          "scope": "resource",
          "markdownDescription": "Patterns written to `.gitignore` when the extension creates a git repository: PLC files `*.Sem`, `*.Wrk`, and `*-Restore*/` for the flat copies made by **Make Restore Folder**. Uses [.gitignore pattern syntax](https://git-scm.com/docs/gitignore). If a `.gitignore` already exists in that folder, only missing patterns are added."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test:snippets": "mocha --ui tdd test/externalSnippets.test.js",
    "test:unit": "mocha --ui tdd test/*.test.js",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.13.0"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5"
  },
  "icon": "src/images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cpapplefamily/Fanuc_FTP_-Extension"
  }
}
